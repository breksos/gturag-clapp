# Derived, never committed (PLAYBOOK §5): the depot is a copy, the sources are the truth.
pkg/
*.clapp
*.clapp.sha256

# Rust
target/

# Tauri regenerates these from tauri.conf.json on every build.
src-tauri/gen/

# Node / Vite
node_modules/
dist/

# The provisioned artifacts — model weights and the corpus index are downloaded,
# not committed. The builder writes them here while working.
tools/build-index/work/
tools/build-index/out/
*.safetensors
*.onnx

# NOTE: corpus.gtu is deliberately NOT ignored. It is committed, because the repository is
# the database: `forms/*.json` is the reviewable source and corpus.gtu is the built index
# the depot ships and `gturag sync` fetches. It is ~6 MB and changes only when the corpus
# is rebuilt.

# A reference copy of another clapp's source, kept locally to compare against. Not ours,
# not a submodule, and not something a clone of this repo should try to fetch.
jlcpcb-clapp/

# The university's own document list, supplied for the corpus expansion. Input to the
# builder, not source.
*.xlsx

# Python bytecode from the maintainer scripts.
__pycache__/
